# Supabase project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
# Public address of the app. Not read by the code yet: invite links use the
# browser's current address.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Live flight status (server only; never prefix these with NEXT_PUBLIC_) ---
# Set ONE provider key. Leave both empty to show scheduled times plus tracking links only.
# aviationstack (free plan, no card: https://aviationstack.com/signup/free). Preferred if set.
AVIATIONSTACK_API_KEY=
# FlightAware AeroAPI personal key (needs a card on file).
FLIGHTAWARE_API_KEY=
# Optional limits. Defaults: aviationstack 15/day and 90/month; FlightAware 100/day and 500/month.
# FLIGHT_STATUS_DAILY_CAP=15
# FLIGHT_STATUS_MONTHLY_CAP=90
# Random secret that lets the app server write the shared flight_status table.
# Generate:  node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Then store its hash in the database (SQL editor):
#   insert into private.app_secrets (name, hash)
#   values ('flight_status', extensions.digest('<the secret>', 'sha256'))
#   on conflict (name) do update set hash = excluded.hash;
FLIGHT_STATUS_SECRET=
